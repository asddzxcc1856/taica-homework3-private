@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix hw3:  <http://taica.course/hw3/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Task 4 / SHACL — validate the grounded execution data (REFERENCE SOLUTION)
# =============================================================================

# ---- Worked example: FK accuracy check --------------------------------------
hw3:FKAccuracyShape a sh:NodeShape ;
    sh:targetClass hw3:FKComputation ;
    sh:property [
        sh:path hw3:hasPoseError ;
        sh:maxInclusive "0.005"^^xsd:double ;
        sh:message "FK_INACCURATE: pose error above the 0.005 m course threshold" ;
    ] .

# ---- Solution 1: arm out of range -------------------------------------------
hw3:ArmOutOfRangeShape a sh:NodeShape ;
    sh:targetClass hw3:IKComputation ;
    sh:property [
        sh:path hw3:hasTargetDistance ;
        sh:maxInclusive "0.90"^^xsd:double ;
        sh:message "ARM_OUT_OF_RANGE: target distance exceeds the UR5 reach (0.90 m)" ;
    ] .

# ---- Solution 2: not converged ----------------------------------------------
hw3:NoConvergenceShape a sh:NodeShape ;
    sh:targetClass hw3:IKComputation ;
    sh:property [
        sh:path hw3:hasResidual ;
        sh:maxInclusive "0.02"^^xsd:double ;
        sh:message "NO_CONVERGENCE: residual above the 0.02 m course threshold" ;
    ] .
